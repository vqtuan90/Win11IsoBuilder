<UserControl x:Class="Win11IsoBuilder.Views.WindowsCustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Requirement bypass" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel>
                <CheckBox Content="TPM" IsChecked="{Binding Config.Windows.BypassTpm}" Margin="0,0,16,4" />
                <CheckBox Content="Secure Boot" IsChecked="{Binding Config.Windows.BypassSecureBoot}" Margin="0,0,16,4" />
                <CheckBox Content="RAM" IsChecked="{Binding Config.Windows.BypassRam}" Margin="0,0,16,4" />
                <CheckBox Content="Storage" IsChecked="{Binding Config.Windows.BypassStorage}" Margin="0,0,16,4" />
                <CheckBox Content="CPU" IsChecked="{Binding Config.Windows.BypassCpu}" Margin="0,0,16,4" />
            </WrapPanel>

            <TextBlock Text="Local administrator account" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="160" Height="30" Margin="0,0,8,0"
                         Text="{Binding Config.Windows.LocalUsername, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox Width="160" Height="30" x:Name="PasswordBox"
                             PasswordChanged="OnPasswordChanged" />
            </StackPanel>
            <TextBlock Text="(Password is optional; stored only in the offline autounattend.xml.)"
                       Foreground="#6B7280" FontSize="11" Margin="0,2,0,0" />

            <TextBlock Text="Region" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="UI language" FontSize="11" />
                    <TextBox Width="120" Height="30" Text="{Binding Config.Windows.UiLanguage}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Time zone" FontSize="11" />
                    <TextBox Width="200" Height="30" Text="{Binding Config.Windows.TimeZone}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Input locale" FontSize="11" />
                    <TextBox Width="140" Height="30" Text="{Binding Config.Windows.InputLocale}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Computer name" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="140" Height="30" Margin="0,0,8,0"
                          ItemsSource="{Binding ComputerNameModes}"
                          SelectedItem="{Binding Config.Windows.ComputerNameMode, Mode=TwoWay}" />
                <TextBox Width="200" Height="30" Text="{Binding Config.Windows.FixedComputerName}"
                         ToolTip="Used only when mode is Fixed" />
            </StackPanel>

            <TextBlock Text="Storage drivers" FontWeight="SemiBold" Margin="0,12,0,4" />
            <CheckBox Content="Inject Intel VMD/RST storage driver (Intel Core 11th gen and newer)"
                      IsChecked="{Binding Config.Drivers.IncludeIntelVmd}" Margin="0,0,0,4" />
            <TextBlock Text="Without this driver, Windows Setup cannot see NVMe drives on modern Intel laptops (VMD enabled in BIOS)."
                       Foreground="#6B7280" FontSize="11" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <ListBox Width="380" MinHeight="28" MaxHeight="80" Margin="0,0,8,0"
                         ItemsSource="{Binding DriverFolders}"
                         SelectedItem="{Binding SelectedDriverFolder}" />
                <StackPanel>
                    <Button Content="Add folder..." Command="{Binding AddDriverFolderCommand}"
                            Width="100" Height="26" Margin="0,0,0,4" />
                    <Button Content="Remove" Command="{Binding RemoveDriverFolderCommand}"
                            Width="100" Height="26" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="(Optional extra driver folders — every .inf inside is injected, e.g. RST 20.x for Core Ultra.)"
                       Foreground="#6B7280" FontSize="11" />

            <TextBlock Text="Installation mode" FontWeight="SemiBold" Margin="0,12,0,4" />
            <CheckBox Content="Fully automated install (like MDT) — ERASES DISK 0 of the target machine"
                      IsChecked="{Binding Config.Windows.AutoPartition}" />
            <TextBlock Text="WARNING: Setup wipes and partitions Disk 0 with no prompt. Untick to get the interactive drive picker instead."
                       Foreground="#B91C1C" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />

            <TextBlock Text="Remove bloatware" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding Bloatware}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                  Width="220" Margin="0,0,8,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
