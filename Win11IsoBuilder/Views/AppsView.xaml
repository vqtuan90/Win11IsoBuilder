<UserControl x:Class="Win11IsoBuilder.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,8"
                   Text="Tick the apps to install offline at first boot. Apps with no source URL need an installer you supply via 'Add app'." />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Apps}" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Install" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="Silent args" Binding="{Binding SilentArgs}" Width="160" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="220" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Add app..." Command="{Binding AddUserAppCommand}"
                Width="120" Height="32" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </Grid>
</UserControl>
